<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Ascet.AgentConnector</AssemblyName>
    <RootNamespace>Ascet.AgentConnector</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Typed connector to one prepared ASCET instance via an isolated x86 Cebra host.</Description>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AscetConnector.cs" />
  </ItemGroup>
</Project>

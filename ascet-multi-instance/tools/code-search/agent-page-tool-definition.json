{
  "name": "ascet_code_search_page",
  "description": "Read-only ASCET code search with strict occurrence pagination. First call requires operation=search_page and the same query options as ascet_code_search. Three modes: text, identifier_occurrence, regex. New searches always read the live model; continuations use an immutable result snapshot in this same persistent process, expire after 5 minutes and may be evicted. Continue with only cursor. Default limit 50, maximum 200, shared across batch queries with round-robin allocation. Schema v2 always returns searches[]; matched positions keep original Unicode code-point coordinates, preview text carries start_column and explicit truncation flags. A page is at most 128 KiB; context/preview may be shortened, full source is available through ascet_code_read. source_read_complete describes supported source coverage, independent of has_more. No change listeners or incremental index. Invalid, expired and oversized cursors/results fail explicitly. Use one persistent serial Node JSONL process, dist/src/cli.js. Optional filters restrict component OIDs, member IDs/names, kinds, implementation OIDs and variants for the whole batch. Component OIDs use direct native lookup; regex workers are reused without caching source across fresh searches.",
  "inputSchema": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "query"
            ],
            "not": {
              "required": [
                "queries"
              ]
            }
          },
          {
            "required": [
              "queries"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "query"
                  ]
                },
                {
                  "required": [
                    "mode"
                  ]
                },
                {
                  "required": [
                    "case_sensitive"
                  ]
                },
                {
                  "required": [
                    "multiline"
                  ]
                },
                {
                  "required": [
                    "dotall"
                  ]
                }
              ]
            }
          }
        ],
        "allOf": [
          {
            "$ref": "#/$defs/queryRules"
          }
        ],
        "properties": {
          "id": {},
          "query": {
            "$ref": "#/$defs/pattern"
          },
          "mode": {
            "$ref": "#/$defs/mode"
          },
          "case_sensitive": {
            "type": "boolean",
            "default": false
          },
          "multiline": {
            "type": "boolean",
            "default": false
          },
          "dotall": {
            "type": "boolean",
            "default": false
          },
          "context_before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          },
          "context_after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          },
          "scope": {
            "type": "string",
            "enum": [
              "database"
            ],
            "default": "database"
          },
          "expected_database": {
            "type": "string",
            "minLength": 1
          },
          "result_format": {
            "type": "string",
            "enum": [
              "expanded",
              "shared"
            ],
            "default": "expanded"
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query"
              ],
              "allOf": [
                {
                  "$ref": "#/$defs/queryRules"
                }
              ],
              "properties": {
                "id": {},
                "query": {
                  "$ref": "#/$defs/pattern"
                },
                "mode": {
                  "$ref": "#/$defs/mode"
                },
                "case_sensitive": {
                  "type": "boolean",
                  "default": false
                },
                "multiline": {
                  "type": "boolean",
                  "default": false
                },
                "dotall": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
          "operation": {
            "type": "string",
            "const": "search_page"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50,
            "description": "Maximum occurrence positions across the entire response, including all batch queries."
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "description": "Common scope for all queries. OR within each list; AND across fields. Exact case-sensitive metadata values. Omit to search the database.",
            "properties": {
              "component_oids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z]{29}$"
                }
              },
              "member_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 256,
                  "not": {
                    "pattern": "[\\r\\n\\u0000]"
                  }
                }
              },
              "member_names": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 256,
                  "not": {
                    "pattern": "[\\r\\n\\u0000]"
                  }
                }
              },
              "kinds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "enum": [
                    "method",
                    "process",
                    "header",
                    "external_c",
                    "external_h",
                    "state_entry",
                    "state_static",
                    "state_exit",
                    "transition_trigger",
                    "transition_action",
                    "transition_condition",
                    "state_entry_binding",
                    "state_static_binding",
                    "state_exit_binding",
                    "transition_trigger_binding",
                    "transition_action_binding",
                    "transition_condition_binding",
                    "graphical_method"
                  ]
                }
              },
              "implementation_oids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 256,
                  "not": {
                    "pattern": "[\\r\\n\\u0000]"
                  },
                  "description": "Empty string selects the base implementation."
                }
              },
              "variants": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 256,
                  "not": {
                    "pattern": "[\\r\\n\\u0000]"
                  },
                  "minLength": 1
                }
              }
            }
          }
        },
        "required": [
          "operation"
        ]
      },
      {
        "type": "object",
        "required": [
          "cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Opaque next_cursor from this session; all other fields must be omitted."
          }
        }
      }
    ],
    "$defs": {
      "pattern": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "not": {
          "pattern": "\u0000"
        }
      },
      "mode": {
        "type": "string",
        "enum": [
          "text",
          "identifier_occurrence",
          "regex"
        ],
        "default": "text"
      },
      "queryRules": {
        "allOf": [
          {
            "if": {
              "required": [
                "multiline"
              ],
              "properties": {
                "multiline": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "query": {
                  "not": {
                    "pattern": "[\r\n]"
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "identifier_occurrence"
                }
              }
            },
            "then": {
              "properties": {
                "query": {
                  "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
                },
                "multiline": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "dotall"
              ],
              "properties": {
                "dotall": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "mode",
                "multiline"
              ],
              "properties": {
                "mode": {
                  "const": "regex"
                },
                "multiline": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  }
}
